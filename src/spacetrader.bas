   1 REM ================================
   2 REM SPACETRADER FOR THE TS2068
   3 REM ================================
   4 REM BUILD WITH TOOLS/BUILD_GAME.SH,
   5 REM WHICH APPENDS THE GENERATED
   6 REM BLOCKS:
   7 REM   8000-8040 CODE LOADER
   8 REM   8500-8730 CODE DATA
   9 REM   9000-9090 SECTOR TABLE
  10 REM   9500-9690 SYSTEM NAMES
  11 REM   9800-9870 TRADE GOODS
  12 REM
  13 REM MEMORY - SEE DOCS/MEMORY-MAP.MD
  14 REM   49168 $C000 MACHINE CODE
  15 REM   50176 $C200 SECTOR TABLE
  16 REM   50296 $C278 ART PRESENCE TBL
  17 REM   51200 $C800 ECM STAGE BUFFER
  18 REM   63424 $F7C0 ECM STACK, KEEP OUT
  19 REM
  20 REM NEVER USE CLS ONCE ART IS UP.
  21 REM CLS CLEARS ROWS 0-21 AND WOULD
  22 REM WIPE THE PICTURE. USE GO SUB 2100.
  23 REM CODE ENTRY POINTS
  24 REM 49168 MODESET  49171 CLR ATTRS
  25 REM 49174 CLR PIX  49177 REVEAL
  26 REM 49180 TEXT ATTRS  49183 EXIT
  27 REM 49186 COLOR ROW  49189 COLOR LINE
  28 REM 49152 MODE 49153 WIPE 49154 SPEED
  29 REM 49155 TEXTATTR 49156 ROW
  30 REM 49157 LINE 49158 ATTR

  40 CLEAR 49151
  55 REM CODE AND SECTOR TABLE ARE CODE
  56 REM BLOCKS IN THIS TAP, NOT DATA -
  57 REM NUMERIC DATA COSTS 6 EXTRA BYTES
  58 REM PER LITERAL AND WILL NOT FIT.
  60 LOAD "stcode" CODE
  65 LOAD "stdata" CODE
  66 REM CUSTOM FONT AT $D000. CHARS IS
  67 REM THE BASE MINUS 256 BECAUSE THE
  68 REM ROM COMPUTES CHARS+CODE*8 AND THE
  69 REM FIRST GLYPH IS CODE 32.
  70 REM ONLY THE HIGH BYTE NEEDS SETTING:
  71 REM THE ROM COLD-STARTS CHARS TO $3C00
  72 REM SO 23606 IS ALREADY ZERO.
  73 LOAD "font" CODE 53248
  74 POKE 23607,207
  75 GO SUB 700: REM TABLES INTO MEMORY
  80 GO SUB 500: REM ENTER ECM
  85 GO SUB 400: REM TITLE SCREEN
  90 GO SUB 600: REM NEW GAME
  92 GO SUB 480: REM NAME THE SHIP
  95 GO TO 1000

 400 REM --------------------------------
 401 REM TITLE SCREEN
 402 REM
 403 REM DRAWN AS AN IMAGE, NOT CODE. A
 404 REM SCREENFUL OF PRINT AT WOULD COST
 405 REM OVER A KILOBYTE OF PROGRAM; THIS
 406 REM COSTS ABOUT TWENTY BYTES AND THE
 407 REM 12K LIVES IN THE TAP INSTEAD.
 408 REM
 409 REM FULL SCREEN, SO BOTH PLANES ARE
 410 REM 6144 BYTES AND GO STRAIGHT TO
 411 REM $6000 AND $4000 - TOO BIG FOR THE
 412 REM 2048-BYTE STAGING BUFFER.
 413 REM --------------------------------
 415 POKE 49155,0: RANDOMIZE USR 49180
 420 RANDOMIZE USR 49171: REM ALL ATTRS BLACK
 425 PRINT AT 8,0;: REM LOADER MESSAGES LAND
 430 REM HERE AND ARE OVERWRITTEN BY THE
 435 REM PIXEL PLANE A MOMENT LATER
 440 LOAD "titatr" CODE 24576
 445 LOAD "titpix" CODE 16384
 450 IF INKEY$<>"" THEN GO TO 450
 455 IF INKEY$="" THEN GO TO 455
 460 RETURN

 480 REM --------------------------------
 481 REM NAME THE SHIP
 482 REM --------------------------------
 483 REM THE TITLE LEFT ITS OWN ATTRIBUTES
 484 REM EVERYWHERE AND ITS PIXELS IN THE
 485 REM ROWS 2100 DOES NOT REACH. 2100
 486 REM CLEARS PIXELS 8-20 ONLY, SO THE
 487 REM RED RULE AND THE WHITE PAPER CELLS
 488 REM SURVIVED UNDERNEATH.
 489 POKE 49155,71: RANDOMIZE USR 49180
 490 RANDOMIZE USR 49171: REM ART ATTRS BLACK
 491 RANDOMIZE USR 49174: REM ART PIXELS BLACK
 492 GO SUB 2100
 493 PRINT AT 21,0;"                                "
 494 PRINT AT 11,2;"NAME YOUR FREE TRADER"
 495 PRINT AT 13,2;"ENTER ALONE FOR BEOWULF"
 496 INPUT n$
 497 IF n$="" THEN LET n$="BEOWULF"
 498 IF LEN n$>16 THEN LET n$=n$( TO 16)
 499 RETURN

 500 REM --------------------------------
 501 REM ENTER EXTENDED COLOR MODE
 502 REM --------------------------------
 510 POKE 49152,2: RANDOMIZE USR 49168
 520 REM TEXT ATTRIBUTES AND THE RULE ARE
 530 REM SET BY 480 AND BY EACH DOCK; DOING
 540 REM THEM HERE IS OVERWRITTEN BY THE
 545 REM TITLE BEFORE ANYTHING SEES IT.
 550 RETURN

 600 REM --------------------------------
 601 REM NEW GAME STATE
 602 REM --------------------------------
 610 LET cr=1000: REM CREDITS
 620 LET fu=8: REM FUEL
 630 LET hu=8: REM HULL
 640 LET ht=0: REM HEAT
 650 LET mx=20: REM CARGO CAPACITY IN TONS
 660 LET cs=1: REM CURRENT SYSTEM
 670 LET tc=0: LET sp=0: LET op=0: LET sel=1: LET rd=0
 675 LET li=0: REM LICENSE BITMASK
 676 LET dt=20000: REM MORTGAGE OWED
 677 LET jc=0: REM JUMPS SINCE PAYMENT
 678 LET ms=0: REM PAYMENTS MISSED
 680 FOR i=1 TO 8: LET q(i)=0: NEXT i
 690 RETURN

 700 REM --------------------------------
 701 REM TABLES FROM DATA INTO MEMORY
 702 REM --------------------------------
 710 DIM q(8): DIM p(8): DIM e(8): DIM j(8)
 720 DIM v(8): DIM l(8): DIM c(8)
 730 DIM d(8): DIM u(8)
 735 REM NAMES AND GOODS ARE FIXED-WIDTH
 736 REM RECORDS IN THE STDATA BLOCK, NOT
 737 REM DATA. A NUMERIC LITERAL COSTS 8
 738 REM BYTES IN BASIC; A BYTE COSTS ONE.
 740 FOR i=1 TO 8
 770 LET v(i)=PEEK (50576+(i-1)*13+11)
 775 LET l(i)=PEEK (50576+(i-1)*13+12)
 780 NEXT i
 799 RETURN

