1500 REM --------------------------------
1501 REM JUMP MENU
1502 REM NEIGHBOURS DERIVED FROM HEX
1503 REM COORDS, NOT STORED
1504 REM --------------------------------
1510 GO SUB 2100
1520 PRINT AT 8,0;"JUMP FROM"
1522 LET ni=cs: LET rw=8: LET cl=10: GO SUB 2900
1525 LET rw=8: LET co=70: GO SUB 2510: LET py=0: LET co=80: GO SUB 2500
1530 LET nc=0
1535 FOR i=1 TO 20
1540 IF i=cs THEN GO TO 1570
1545 LET tb=PEEK (50176+(i-1)*6)
1550 LET tx=INT (tb/16): LET ty=tb-tx*16
1555 LET dx=ABS (tx-scl): LET dy=ABS (ty-srw)
1558 IF dx>2 OR dy>2 THEN GO TO 1570
1560 IF nc=8 THEN GO TO 1570
1562 LET nc=nc+1: LET d(nc)=i
1565 LET u(nc)=1+INT ((dx+dy)/2)
1566 PRINT AT 9+nc,0;nc
1567 LET ni=i: LET rw=9+nc: LET cl=2: GO SUB 2900
1568 PRINT AT 9+nc,16;"F";u(nc)
1570 NEXT i
1575 LET rw=19: LET py=7: LET co=80: GO SUB 2500
1580 PRINT AT 20,0;"SELECT 1-";nc;" OR C)ANCEL"
1585 GO SUB 2000
1588 LET k$=INKEY$: IF k$="" THEN GO TO 1588
1590 IF k$="c" OR k$="C" THEN GO SUB 1100: GO TO 1200
1592 LET sel=CODE k$-48
1595 IF sel<1 OR sel>nc THEN GO TO 1588
1598 GO TO 1600

1600 REM --------------------------------
1601 REM EXECUTE THE JUMP
1602 REM --------------------------------
1605 IF fu<u(sel) THEN LET m$="NOT ENOUGH FUEL": GO SUB 2600: GO SUB 1100: GO TO 1200
1610 LET fu=fu-u(sel)
1615 LET cs=d(sel)
1620 GO SUB 2200: REM UNPACK DESTINATION
1625 REM ENCOUNTER ODDS BY DEST LAW TIER
1630 LET pk=25: LET pa=2: LET tr=15
1635 IF slw>2 THEN LET pk=12: LET pa=8: LET tr=15
1640 IF slw>5 THEN LET pk=3: LET pa=20: LET tr=12
1645 REM HEAT RAISES BOTH
1650 LET pk=pk+INT (ht/10): LET pa=pa+INT (ht/8)
1655 LET r=INT (RND*100)
1660 IF r<pk THEN LET op=0: GO SUB 4000: GO TO 1685
1665 IF r<pk+pa THEN LET sp=1: GO SUB 1900: GO TO 1685
1670 IF r<pk+pa+tr THEN GO SUB 1800
1685 IF ht>0 THEN LET ht=ht-1: REM HEAT COOLS
1687 LET jc=jc+1
1688 IF jc>=8 THEN GO SUB 6700
1690 IF hu<1 THEN LET m$="SHIP DESTROYED": LET co=66: GO TO 5000
1692 IF ms>=2 THEN LET m$="SHIP REPOSSESSED": LET co=66: GO TO 5000
1694 IF dt<=0 THEN LET m$="THE SHIP IS YOURS": LET co=68: GO TO 5000
1695 GO TO 1000

1800 REM --------------------------------
1801 REM TRADE OPPORTUNITY IN TRANSIT
1802 REM --------------------------------
1810 LET bn=50+INT (RND*150)
1820 LET cr=cr+bn
1830 LET m$="CONTRACT PAID "+STR$ bn+" CR"
1840 GO SUB 2600
1850 RETURN

1900 REM --------------------------------
1901 REM CUSTOMS INSPECTION
1902 REM SP=0 AT PORT, SP=1 IN TRANSIT
1903 REM --------------------------------
1905 LET rd=0
1910 LET bs=10
1915 IF slw>2 THEN LET bs=25
1920 IF slw>5 THEN LET bs=45
1925 IF sp=1 THEN LET bs=INT (bs/2)
1930 LET ch=bs+INT (ht/5)
1935 IF ch>70 THEN LET ch=70
1940 IF INT (RND*100)>=ch THEN RETURN
1945 REM FLAGGED - SCAN THE HOLD
1950 LET cb=0
1955 FOR i=1 TO 8
1960 IF q(i)>0 AND c(i)=1 THEN LET cb=cb+q(i)
1965 NEXT i
1970 IF cb=0 THEN LET rd=1: LET m$="INSPECTED - HOLD IS CLEAN": GO SUB 2600: RETURN
1975 LET rd=2: GO SUB 3000
1980 RETURN

2000 REM --------------------------------
2001 REM STATUS LINE, ROW 21
2002 REM --------------------------------
2010 PRINT AT 21,0;"                                "
2020 PRINT AT 21,0;"CR ";cr;" FUEL ";fu;" HULL ";hu;" HEAT ";ht
2030 LET co=71
2040 IF ht>5 THEN LET co=70
2050 IF ht>15 THEN LET co=66
2060 LET rw=21: GO SUB 2510
2070 RETURN

2100 REM --------------------------------
2101 REM BLANK UI ROWS 8-20
2102 REM NOT CLS - THAT WOULD KILL THE ART
2103 REM --------------------------------
2110 FOR r=8 TO 20
2120 PRINT AT r,0;"                                "
2130 NEXT r
2140 RETURN

2200 REM --------------------------------
2201 REM UNPACK SYSTEM CS FROM $C200
2202 REM --------------------------------
2210 LET ba=50176+(cs-1)*6
2215 LET b=PEEK ba
2220 LET scl=INT (b/16): LET srw=b-scl*16
2225 LET b=PEEK (ba+1)
2230 LET stl=INT (b/16): LET slw=b-stl*16
2235 LET b=PEEK (ba+2)
2240 LET sgv=INT (b/16): LET spp=b-sgv*16
2245 LET se=PEEK (ba+3): LET si=PEEK (ba+4)
2250 REM SPLIT THE BITMASKS. SINCLAIR AND
2255 REM IS LOGICAL, NOT BITWISE, SO THIS
2260 REM PULLS BITS ARITHMETICALLY.
2265 LET bt=1
2270 FOR i=1 TO 8
2275 LET e(i)=INT (se/bt)-2*INT (se/(bt*2))
2280 LET j(i)=INT (si/bt)-2*INT (si/(bt*2))
2282 LET c(i)=0
2283 IF l(i)<slw THEN LET c(i)=1
2284 IF INT (li/bt)-2*INT (li/(bt*2))=1 THEN LET c(i)=0
2285 LET bt=bt*2
2290 NEXT i
2299 RETURN

2300 REM --------------------------------
2301 REM ROLL PRICES FOR THIS DOCKING
2302 REM PRICE=BP*(100+ST+POP+TL+VAR)/100
2303 REM --------------------------------
2310 LET pm=10-INT (spp*20/15)
2315 LET tm=10-INT (stl*20/15)
2320 FOR i=1 TO 8
2325 LET st=0
2330 IF e(i)=1 THEN LET st=-30
2335 IF j(i)=1 THEN LET st=40
2340 LET vr=INT (RND*31)-15
2345 LET p(i)=INT (v(i)*(100+st+pm+tm+vr)/100)
2350 IF p(i)<1 THEN LET p(i)=1
2355 NEXT i
2399 RETURN

2400 REM --------------------------------
2401 REM LOAD AND REVEAL THE BAND IMAGE
2402 REM
2403 REM ON ERR CATCHES A MISSING IMAGE
2404 REM SO A GAP IN THE ART SET DOES NOT
2405 REM END THE GAME. THE HANDLER IS
2406 REM REPOINTED RATHER THAN CLEARED -
2407 REM THE ERRATA CALLS THE ENCODING OF
2408 REM ON ERR GO TO 0 UNRELIABLE.
2409 REM --------------------------------
2411 REM BLOCKS LIVE IN THIS SAME TAP AS
2412 REM aNN AND pNN, NN = SYSTEM INDEX.
2413 REM
2414 REM A MOUNTED TAP LOOPS, SO BLOCK
2415 REM ORDER DOES NOT MATTER - BUT A
2416 REM NAME THAT IS NOT ON THE TAPE
2417 REM SEARCHES FOREVER. THAT IS NOT AN
2418 REM ERROR, SO ON ERR CANNOT CATCH IT.
2419 REM CHECK THE PRESENCE TABLE FIRST.
2420 IF PEEK (50296+cs-1)=0 THEN GO TO 2470
2421 LET t$=STR$ cs
2426 IF cs<10 THEN LET t$="0"+t$
2427 REM THE ROM PRINTS "Bytes: aNN" FOR
2428 REM EVERY BLOCK AND FLICKERS THE
2429 REM BORDER. NEITHER CAN BE SWITCHED
2430 REM OFF, SO USE THEM: BLACK EVERY
2431 REM ATTRIBUTE FIRST AND THE MESSAGES
2432 REM LOAD INVISIBLY WHILE THE BORDER
2433 REM BECOMES THE JUMP EFFECT.
2434 PRINT AT 20,0;"PREPARE FOR JUMP                "
2435 PAUSE 25
2436 ON ERR GO TO 2470
2437 POKE 49155,0: RANDOMIZE USR 49180
2438 RANDOMIZE USR 49171: REM ART BAND BLACK
2439 REM PARK THE CURSOR HIGH ENOUGH THAT
2440 REM TWO MESSAGES FIT WITHOUT SCROLLING
2441 REM - A SCROLL WOULD DRAG THE WHOLE
2442 REM UPPER SCREEN, ART INCLUDED.
2443 PRINT AT 9,0;
2445 LET f$="a"+t$: LOAD f$ CODE 51200
2450 LET f$="p"+t$: LOAD f$ CODE 16384
2455 GO SUB 2100: REM WIPE THE MESSAGES
2458 REM WHILE STILL BLACK, THEN RESTORE
2460 POKE 49155,71: RANDOMIZE USR 49180
2461 POKE 49153,1+INT (RND*4)
2462 RANDOMIZE USR 49177
2465 ON ERR GO TO 5000
2467 RETURN
2470 REM IMAGE MISSING - CARRY ON BLANK
2475 ON ERR GO TO 5000
2480 RANDOMIZE USR 49171
2485 RANDOMIZE USR 49174
2490 LET m$="NO IMAGE FOR THIS SYSTEM"
2492 GO SUB 2600
2495 RETURN

