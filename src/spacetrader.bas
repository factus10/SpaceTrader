2960 REM --------------------------------
2961 REM ENCOUNTER FRAME, TOP HALF
2962 REM ENTRY M$=HEADER
2963 REM --------------------------------
2965 GO SUB 2100
2966 PRINT AT 8,0;m$
2967 LET rw=8: LET co=66: GO SUB 2510
2968 RETURN

2980 REM --------------------------------
2981 REM ENCOUNTER FRAME, BOTTOM HALF
