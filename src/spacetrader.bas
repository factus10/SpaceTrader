3000 REM --------------------------------
3001 REM CONTRABAND FOUND
3002 REM --------------------------------
3010 LET m$="CUSTOMS INSPECTION": GO SUB 2960
3030 PRINT AT 11,2;"CONTRABAND FOUND"
3035 PRINT AT 12,2;cb;" TONS RESTRICTED HERE"
3040 LET fi=cb*40
3045 PRINT AT 14,2;"FINE ";fi;" CR"
3050 LET s$="COMPLY     BRIBE"
3055 LET t$="SURRENDER  RESIST": GO SUB 2980
3070 IF k$="c" OR k$="C" THEN GO TO 3100
3075 IF k$="b" OR k$="B" THEN GO TO 3200
3080 IF k$="s" OR k$="S" THEN GO TO 3300
3085 IF k$="r" OR k$="R" THEN GO TO 3400
3090 GO TO 3050

3100 REM COMPLY - PAY THE FINE
3110 LET cr=cr-fi
3115 IF cr<0 THEN LET cr=0
3120 GO SUB 3500: REM CONFISCATE
3130 LET ht=ht+4
3140 LET m$="FINE PAID, CARGO SEIZED"
3150 GO SUB 2600
