2708 LET rw=20: LET co=71: GO SUB 2510
2710 LET co=70: LET sz=1
2720 LET cl=0: GO SUB 2520
2730 LET cl=4: GO SUB 2520
2740 LET cl=9: GO SUB 2520
2750 LET cl=14: GO SUB 2520
