3215 LET bc=70-ht
3220 IF bc<20 THEN LET bc=20
3225 IF INT (RND*100)<bc THEN LET m$="THE INSPECTOR LOOKS AWAY": GO SUB 2600: RETURN
3230 LET cr=cr-fi*2
3235 IF cr<0 THEN LET cr=0
3240 GO SUB 3500
3245 LET ht=ht+8
3250 LET m$="BRIBE REFUSED - IT GOES BADLY"
