4000 REM --------------------------------
4001 REM COMBAT, MENU RESOLVED
4002 REM ENTRY OP: 0=PIRATE 1=PATROL
4003 REM STAKES ARE CARGO AND HULL,
4004 REM NOT DEATH
4005 REM --------------------------------
4010 LET eh=4+INT (RND*5)
4015 IF op=1 THEN LET eh=eh+3
4025 LET m$="PIRATE CORVETTE CLOSING"
4030 IF op=1 THEN LET m$="PATROL CUTTER CLOSING"
4035 GO SUB 2960
4040 PRINT AT 11,2;"THEIR HULL ";eh
4045 PRINT AT 12,2;"YOUR HULL  ";hu
4050 PRINT AT 14,2;"CARGO AT RISK ";tc;" TONS"
4055 LET s$="EVADE      FIGHT"
4060 LET t$="BRIBE      RUN": GO SUB 2980
4075 IF k$="f" OR k$="F" THEN GO TO 4100
4080 IF k$="e" OR k$="E" THEN GO TO 4200
4085 IF k$="b" OR k$="B" THEN GO TO 4300
4090 IF k$="r" OR k$="R" THEN GO TO 4200
4095 GO TO 4055

4100 REM FIGHT - COMPARE HULL PLUS RNG
4110 LET mr=hu+INT (RND*6)
4115 LET er=eh+INT (RND*6)
4120 IF mr>=er THEN LET m$="THEY BREAK OFF, DAMAGED": GO SUB 2600: RETURN
4125 LET hu=hu-1-INT (RND*2)
4130 GO SUB 4400: REM LOSE CARGO
4140 LET m$="HIT - YOU LOSE CARGO"
4150 GO SUB 2600
4160 RETURN

4200 REM EVADE OR RUN
4210 IF INT (RND*100)<50+fu*3 THEN LET m$="YOU SLIP AWAY": GO SUB 2600: RETURN
4220 LET hu=hu-1
4230 GO SUB 4400
4240 LET m$="CAUGHT - CARGO TAKEN"
4250 GO SUB 2600
4260 RETURN

4300 REM BRIBE THE ATTACKER
4310 LET bc=60-ht
4315 IF bc<15 THEN LET bc=15
4320 IF cr<200 THEN LET m$="NOT ENOUGH TO OFFER": GO SUB 2600: GO TO 4055
4325 LET cr=cr-200
