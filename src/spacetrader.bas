1320 IF gi<1 OR gi>8 THEN GO TO 1200
1330 INPUT "HOW MANY TONS? ";nt
1340 IF nt<1 THEN GO TO 1200
1350 IF nt*p(gi)>cr THEN LET m$="NOT ENOUGH CREDITS": GO SUB 2600: GO TO 1200
1360 IF tc+nt>mx THEN LET m$="NOT ENOUGH CARGO SPACE": GO SUB 2600: GO TO 1200
1370 LET cr=cr-nt*p(gi)
1380 LET q(gi)=q(gi)+nt: LET tc=tc+nt
