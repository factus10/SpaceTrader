   1 REM ECM BAND TEST
   2 REM
   3 REM ANSWERS THE OPEN QUESTIONS IN
   4 REM DOCS/UI-LAYOUT.MD, IN THE ORDER
   5 REM THEY WOULD BREAK. EVERYTHING IS
   6 REM IN THIS ONE TAP - NO TS-PICO
   7 REM MOUNT, JUST LOAD BY NAME.
   8 REM
   9 REM BLOCKS: BASIC, STCODE,
  10 REM         OSSATR, OSSPIX
  11 REM
  20 CLEAR 49151
  30 LOAD "stcode" CODE
  40 REM ---- 1. ENTER ECM ----
  50 REM IF THE DISPLAY DOES NOT CHANGE,
  60 REM CHNG_VID REFUSED - THE PROGRAM
  70 REM IS TOO CLOSE TO RAMTOP.
  80 POKE 49152,2: RANDOMIZE USR 49168
  90 REM ---- 2. TEXT ATTRIBUTES ----
 100 REM WITHOUT THIS EVERY PRINT BELOW
 110 REM IS BLACK ON BLACK AND INVISIBLE.
 120 POKE 49155,71: RANDOMIZE USR 49180
 130 PRINT AT 9,0;"1 READABLE? TEXT ATTRS OK"
 140 PRINT AT 10,0;"2 RULE UNDER ART 1PX TALL?"
 150 PRINT AT 11,0;"3 ROW BELOW SHOULD INVERT"
 160 PRINT AT 12,0;"  INVERSE ROW TEST"
 170 LET rw=12: LET co=120: GO SUB 900
 180 REM ---- 3. HAIRLINE RULE ----
 190 REM ROW 8, TOP PIXEL LINE, GREEN.
 200 REM ONE PIXEL TALL, NOT EIGHT.
 210 LET rw=8: LET py=0: LET co=96: GO SUB 930
 220 REM ---- 4. PER-ROW RECOLOR ----
 230 PRINT AT 14,0;"4 THIS ROW CYCLES COLOR"
 240 FOR c=1 TO 7
 250 LET rw=14: LET co=64+c: GO SUB 900
 260 PAUSE 20
 270 NEXT c
 280 LET rw=14: LET co=71: GO SUB 900
 290 REM ---- 5. BAND IMAGE ----
 300 PRINT AT 16,0;"5 LOADING BAND IMAGE"
 310 RANDOMIZE USR 49171
 320 LOAD "ossatr" CODE 51200
 330 LOAD "osspix" CODE 16384
 340 PRINT AT 16,0;"5 WIPE MODE            "
 350 POKE 49154,6
 360 FOR w=0 TO 4
 370 RANDOMIZE USR 49171
 380 PRINT AT 16,11;w
 390 POKE 49153,w
 400 RANDOMIZE USR 49177
 410 PAUSE 80
 420 NEXT w
 430 REM ---- 6. LOWER SCREEN ----
 440 REM ROWS 22-23 ARE ROM MANAGED.
 450 REM IF THIS CORRUPTS BAND 2 ATTRS
 460 REM THE STATUS LINE NEEDS REPAINTING.
 470 PRINT AT 18,0;"6 LOWER SCREEN BELOW"
 480 PRINT #1;AT 0,0;"ROWS 22-23 READABLE?";
 490 PRINT AT 20,0;"DONE - PRESS A KEY"
 500 PAUSE 0
 510 STOP

 900 REM COLOR A WHOLE ROW
 910 POKE 49156,rw: POKE 49158,co
 920 RANDOMIZE USR 49186: RETURN

 930 REM COLOR ONE PIXEL LINE
 940 POKE 49156,rw: POKE 49157,py
 950 POKE 49158,co: RANDOMIZE USR 49189
 960 RETURN
